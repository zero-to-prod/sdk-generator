#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
|------------------------------------------------------------------------------
| Template initialisation
|------------------------------------------------------------------------------
|
| Rebrand this SDK template into a concrete package, then build it. Run this
| once, from the repository root:
|
|     php init
|
| It prompts for the package identity, rewrites every file that carries a
| template name, installs dependencies, generates src/Models and src/ApiRoute.php
| from the OpenAPI document you named, runs `composer fix`, and deletes itself.
| The package is ready for `composer test` when it finishes.
|
| Edit TEMPLATE when the template's own identity changes. Every key referenced
| anywhere below MUST exist in TEMPLATE: under declare(strict_types=1) a missing
| key is a fatal error on the very first run, which is the worst possible place
| to discover a typo. Nothing is written until the proposed values have been
| displayed and confirmed.
|
*/

const TEMPLATE = [
    'slug' => 'sdk',
    'vendor' => 'zero-to-prod',
    'package' => 'zero-to-prod/sdk',
    'namespace' => 'Zerotoprod\\Sdk',
    'title' => 'SDK',
    'description' => 'Template for a framework-agnostic PHP SDK generated from an OpenAPI document',
    'api_class' => 'SdkApi',
    'config_class' => 'SdkConfig',
    'bin' => 'sdk',
    'docs_url' => 'https://example.com/docs',
    // The CLAUDE.md opening line, replaced wholesale for a derived package.
    'claude_intro' => 'This repo is the SDK **template** — the common ancestor of every derived SDK package. Work here as if the change ships to every descendant, because it does.',
];

const SKIP_DIRECTORIES = ['.git', '.idea', 'vendor', '.vendor', 'node_modules', '.phpunit.cache', 'coverage', 'build'];
/*
| Files the rewrite must not touch.
|
| `scripts/check-template` names the UPSTREAM template package so it can tell a
| derived package apart from the template itself. Rewriting that constant makes
| every derived package report "this is the template" and silently downgrade its
| ancestry checks from fatal to advisory -- the one check that exists to catch a
| broken merge setup stops checking.
*/
const SKIP_FILES = ['init', 'composer.lock', 'package-lock.json', '.env', '.DS_Store', 'check-template'];

/*
| Template-only files, deleted along with init itself.
|
| Each of these tests the template as a template, so in a derived package it is
| either meaningless or actively wrong:
|
|   InitTest            tests the script that has just deleted itself.
|   ReadmeExamplesTest  mirrors every code block in the template's README; a
|                       derived package rewrites that README, so mirroring the
|                       template's examples asserts nothing about this package.
|   ExampleDomainTest   the only test that names the shipped Widget example
|                       domain, which `composer generate-sdk` replaces wholesale.
|
| Everything else under tests/ is domain-agnostic on purpose: the shared suite
| dispatches against tests/Fixtures/FixtureRoute, never against the generated
| ApiRoute, so it keeps merging down from the template forever.
*/
const TEMPLATE_ONLY = [
    'tests/Unit/InitTest.php',
    'tests/Unit/ReadmeExamplesTest.php',
    'tests/Unit/ExampleDomainTest.php',
];

$root = __DIR__;

if (realpath((string) getcwd()) !== realpath($root)
    || ! is_file($root.'/composer.json')
    || ! is_file($root.'/sdk.json')) {
    fwrite(STDERR, "init: run this from the repository root of the SDK template (composer.json and sdk.json required).\n");

    exit(1);
}

writeln('');
writeln('  PHP SDK package template');
writeln('  Press enter to accept the value in brackets.');

$answers = [];

do {
    $answers = ask_all($root, $answers);
    summarise($answers);
} while (! confirm('Write these values', true));

$changed = rewrite($root, $answers);
$renamed = rename_files($root, $answers);

writeln('');
writeln(sprintf(
    '  Rewrote %d file%s, renamed %d.',
    $changed,
    $changed === 1 ? '' : 's',
    $renamed,
));

report_removed(remove_template_only($root));

/*
| The template's own InitTest drives this script for real, in a throwaway copy
| of the repository, to assert what the rewrite produced. Everything below
| installs dependencies and runs the whole suite -- minutes of work per test,
| none of it what those tests look at.
*/
if (getenv('SDK_INIT_SKIP_BUILD') === '1') {
    next_steps($answers);

    exit(0);
}

write_env($root);
install($root);
generate_sdk($root);
verify($root);
next_steps($answers);

exit(0);

/*
|------------------------------------------------------------------------------
| Build
|------------------------------------------------------------------------------
*/

/**
 * Copy .env.example, which every script in scripts/ sources for PHP_VERSION.
 */
function write_env(string $root): void
{
    if (is_file($root.'/.env') || ! is_file($root.'/.env.example')) {
        return;
    }

    copy($root.'/.env.example', $root.'/.env');

    writeln('  Created .env from .env.example.');
}

/**
 * Install dependencies into both trees that need them.
 *
 * vendor/ is the host tree. `scripts/generate-sdk` runs on the host PHP and
 * requires it, and installing also redumps the autoloader the namespace rewrite
 * just invalidated -- otherwise every class in the package reads as missing.
 *
 * .vendor/php8.x is mounted at /app/vendor inside the docker services that run
 * the tests and every check. Only a container can write it correctly: composer
 * records the project root as a path relative to the vendor directory it is
 * handed, so a host-side dump of .vendor/php8.1 is wrong the moment that tree
 * is mounted one level shallower.
 */
function install(string $root): void
{
    if (! available('composer')) {
        writeln('  composer is not on PATH; run `composer install` yourself.');

        return;
    }

    run($root, 'composer install --no-interaction');

    if (! docker_running()) {
        writeln('  docker is not running; run `composer deps install` before `composer test`.');

        return;
    }

    if (run($root, 'composer deps install') !== 0) {
        // Two causes, in order of likelihood. A transient download failure --
        // composer cannot roll back cleanly here, because /app/vendor is the
        // mount point itself, so it aborts with "Could not delete /app/vendor"
        // and a rerun fixes it. Or a composer.lock resolved on a newer PHP than
        // the oldest version the package supports, which no rerun will fix.
        writeln('  The container install failed. Rerun `composer deps install`;');
        writeln('  if it fails the same way, re-resolve the lock: `composer deps update`.');
    }
}

/**
 * Generate src/Models and src/ApiRoute.php from the OpenAPI document.
 *
 * --force because the rewrite above left uncommitted edits under src/, and the
 * generator refuses to overwrite uncommitted work without it.
 */
function generate_sdk(string $root): void
{
    if (! is_file($root.'/vendor/autoload.php')) {
        writeln('  Skipped generation: no vendor/. Run `composer install && composer generate-sdk -- --force`.');

        return;
    }

    if (run($root, 'scripts/generate-sdk --force') !== 0) {
        writeln('  Generation failed. Check `openapi.source` in sdk.json, then run `composer generate-sdk -- --force`.');
    }
}

/**
 * Format, regenerate the derived annotations and docs, analyse, and test.
 */
function verify(string $root): void
{
    if (! docker_running()) {
        writeln('  docker is not running; run `composer fix` when it is.');

        return;
    }

    // Every step of `composer fix` runs a binary out of the mounted container
    // vendor tree, so without one it fails on the first line with exit 127.
    if (glob($root.'/.vendor/php*/autoload.php') === []) {
        writeln('  Skipped `composer fix`: no container vendor tree yet.');
        writeln('  Run `composer deps install` (or `composer deps update`), then `composer fix`.');

        return;
    }

    if (run($root, 'composer fix') !== 0) {
        writeln('  `composer fix` reported problems; fix them, then run `composer check`.');
    }
}

function run(string $root, string $command): int
{
    writeln('');
    writeln('  $ '.$command);
    writeln('');

    passthru(sprintf('cd %s && %s', escapeshellarg($root), $command), $status);

    return $status;
}

function available(string $command): bool
{
    return trim((string) shell_exec('command -v '.escapeshellarg($command).' 2>/dev/null')) !== '';
}

function docker_running(): bool
{
    exec('docker info > /dev/null 2>&1', $output, $status);

    return $status === 0;
}

/*
|------------------------------------------------------------------------------
| Input
|------------------------------------------------------------------------------
*/

/**
 * @param  array<string, string>  $previous
 * @return array<string, string>
 */
function ask_all(string $root, array $previous = []): array
{
    writeln('');

    $was = static fn (string $key, string $fallback): string => $previous[$key] ?? $fallback;

    $slug = slugify(ask('Package slug', $was('slug', slugify(basename($root)) ?: TEMPLATE['slug']))) ?: TEMPLATE['slug'];
    $vendor = slugify(ask('Vendor (composer vendor + namespace root)', $was('vendor', slugify(git('config user.name')) ?: TEMPLATE['vendor'])));
    $namespace = trim(ask('PHP namespace', $was('namespace', namespace_for($vendor, $slug))), '\\') ?: TEMPLATE['namespace'];
    $title = ask('Title', $was('title', titleise($slug)));
    $description = ask('Description', $was('description', TEMPLATE['description']));
    $api_class = ask('API class name', $was('api_class', api_class_for($namespace, $slug))) ?: TEMPLATE['api_class'];
    $config_class = ask('Config class name', $was('config_class', config_class_for($api_class))) ?: TEMPLATE['config_class'];

    return [
        'slug' => $slug,
        'vendor' => $vendor,
        'namespace' => $namespace,
        'title' => $title,
        'description' => $description,
        'api_class' => $api_class,
        'config_class' => $config_class,
        'base_url' => ask('Base URL', $was('base_url', 'https://api.'.$slug.'.com')),
        'docs_url' => ask('Docs URL', $was('docs_url', TEMPLATE['docs_url'])),
        // Required: the package is not finished until its models exist, and
        // they come from this document.
        'openapi_source' => ask_source($root, $was('openapi_source', '')),
        'author' => ask('Author name', $was('author', git('config user.name'))),
        'author_email' => ask('Author email', $was('author_email', git('config user.email'))),
    ];
}

/** @param array<string, string> $answers */
function summarise(array $answers): void
{
    writeln('');
    writeln('  This is what will be written:');
    writeln('');

    $rows = [
        'Package' => composer_name($answers),
        'Namespace' => $answers['namespace'],
        'Title' => $answers['title'],
        'Description' => $answers['description'],
        'API class' => $answers['api_class'],
        'Config class' => $answers['config_class'],
        'Binary' => 'bin/'.$answers['slug'],
        'Base URL' => $answers['base_url'],
        'Docs URL' => $answers['docs_url'],
        'OpenAPI' => $answers['openapi_source'],
        'Repository' => repository($answers),
        'Author' => author($answers),
    ];

    foreach ($rows as $label => $value) {
        writeln(sprintf('    %-14s %s', $label, $value !== '' ? $value : '(not set)'));
    }

    writeln('');
}

/*
|------------------------------------------------------------------------------
| Rewriting
|------------------------------------------------------------------------------
*/

/**
 * The literal strings that identify the template, mapped to their replacement.
 *
 * strtr() with an array tries the longest key at each position and never
 * rescans what it has written, so `Zerotoprod\Sdk\SdkApi` resolves to
 * `<namespace>\<ApiClass>` in one pass without the namespace key eating the
 * class key. The doubled-backslash entry catches the JSON- and PHP-string
 * escaped form of the namespace, e.g. "Zerotoprod\\Sdk\\Models".
 *
 * @param  array<string, string>  $answers
 * @return array<string, string>
 */
function replacements(array $answers): array
{
    $escape = static fn (string $namespace): string => str_replace('\\', '\\\\', $namespace);

    return [
        $escape(TEMPLATE['namespace']) => $escape($answers['namespace']),
        TEMPLATE['namespace'] => $answers['namespace'],
        TEMPLATE['config_class'].'Factory' => $answers['config_class'].'Factory',
        TEMPLATE['config_class'] => $answers['config_class'],
        TEMPLATE['api_class'] => $answers['api_class'],
        TEMPLATE['package'] => composer_name($answers),
        'bin/'.TEMPLATE['bin'] => 'bin/'.$answers['slug'],
        'scripts/'.TEMPLATE['bin'] => 'scripts/'.$answers['slug'],
        'docs/skills/'.TEMPLATE['bin'].'.md' => 'docs/skills/'.$answers['slug'].'.md',
        TEMPLATE['docs_url'] => $answers['docs_url'],
        TEMPLATE['description'] => $answers['description'],
        // CLAUDE.md opens by telling an agent it is working *in* the template.
        // That is the one claim a derived package must not inherit verbatim, or
        // every agent it ever runs starts from a false premise about what the
        // repository is and what its edits affect.
        TEMPLATE['claude_intro'] => sprintf(
            'This package was generated from the `%s` template and keeps it as a git remote named `template`, so shared client code merges forward from there. Run `composer check-template` to verify the wiring and see `docs/template.md` for the runbook.',
            TEMPLATE['package']
        ),
    ];
}

/** @param array<string, string> $answers */
function rewrite(string $root, array $answers): int
{
    $replacements = array_filter(
        replacements($answers),
        static fn (string $value, string $key): bool => $key !== '' && $key !== $value,
        ARRAY_FILTER_USE_BOTH,
    );

    $changed = 0;

    foreach (files($root) as $file) {
        $contents = (string) file_get_contents($file);
        $rewritten = $replacements === [] ? $contents : strtr($contents, $replacements);

        if ($rewritten === $contents) {
            continue;
        }

        file_put_contents($file, $rewritten);
        $changed++;
    }

    rewrite_composer($root, $answers);
    rewrite_sdk_json($root, $answers);

    return $changed + 2;
}

/**
 * Rename one key in place, keeping the surrounding order.
 *
 * Composer prints its script listing in declaration order, so rebuilding the
 * array would reshuffle the block CLAUDE.md is compared against.
 *
 * @param  array<string, mixed>  $map
 * @return array<string, mixed>
 */
function rename_key(array $map, string $from, string $to): array
{
    if ($from === $to || ! array_key_exists($from, $map)) {
        return $map;
    }

    $renamed = [];

    foreach ($map as $key => $value) {
        $renamed[$key === $from ? $to : $key] = $value;
    }

    return $renamed;
}

/** @param array<string, string> $answers */
function rewrite_composer(string $root, array $answers): void
{
    $path = $root.'/composer.json';

    $json = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    $json = is_array($json) ? $json : [];

    // Union, not assignment: `name` has to come out first in the encoded file.
    $json = ['name' => composer_name($answers)] + $json;
    $json['description'] = $answers['description'];

    $author = author_record($answers);

    if ($author !== null) {
        $json['authors'] = [$author];
    }

    if (isset($json['autoload']['psr-4']) && is_array($json['autoload']['psr-4'])) {
        // `factories/` is mapped in the main autoload, not autoload-dev: the
        // factories ship with the package so a consumer can import them.
        $json['autoload']['psr-4'] = remap_psr4(
            remap_psr4($json['autoload']['psr-4'], 'src/', $answers['namespace'].'\\'),
            'factories/',
            $answers['namespace'].'\\Factories\\',
        );
    }

    $json['bin'] = ['bin/'.$answers['slug']];

    // The composer script that runs the package CLI is named after the CLI, and
    // scripts/listing.php reads that name for the block CLAUDE.md carries. The
    // token pass above already repointed the script at `scripts/<slug>`, so
    // renaming the file without renaming its key leaves the listing advertising
    // a `sdk` command that no longer exists -- and check-claude-md failing on a
    // package nobody has touched.
    foreach (['scripts', 'scripts-descriptions'] as $block) {
        if (isset($json[$block]) && is_array($json[$block])) {
            $json[$block] = rename_key($json[$block], TEMPLATE['bin'], $answers['slug']);
        }
    }

    $repository = repository($answers);

    if ($repository !== '') {
        $json['homepage'] = $repository;
        $json['support'] = ['issues' => $repository.'/issues'];
    }

    write_json($path, $json);
}

/** @param array<string, string> $answers */
function rewrite_sdk_json(string $root, array $answers): void
{
    $path = $root.'/sdk.json';

    $json = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    $json = is_array($json) ? $json : [];

    $json['name'] = composer_name($answers);
    $json['namespace'] = $answers['namespace'];
    $json['title'] = $answers['title'];
    $json['description'] = $answers['description'];
    $json['api_class'] = $answers['api_class'];
    $json['config_class'] = $answers['config_class'];
    $json['bin'] = $answers['slug'];
    $json['base_url'] = $answers['base_url'];
    $json['docs_url'] = $answers['docs_url'];

    $openapi = isset($json['openapi']) && is_array($json['openapi']) ? $json['openapi'] : [];
    $openapi['source'] = $answers['openapi_source'];
    $json['openapi'] = $openapi;

    write_json($path, order_keys($json, [
        '$comment',
        'name',
        'namespace',
        'title',
        'description',
        'api_class',
        'config_class',
        'bin',
        'base_url',
        'docs_url',
        'retain_models',
        'openapi',
    ]));
}

/**
 * Reorder the keys we know about and append everything else untouched, so a
 * derived package never loses configuration the template did not anticipate.
 *
 * @param  array<string, mixed>  $json
 * @param  list<string>  $order
 * @return array<string, mixed>
 */
function order_keys(array $json, array $order): array
{
    $ordered = [];

    foreach ($order as $key) {
        if (array_key_exists($key, $json)) {
            $ordered[$key] = $json[$key];
        }
    }

    return $ordered + $json;
}

/**
 * @param  array<array-key, mixed>  $psr4
 * @return array<string, mixed>
 */
function remap_psr4(array $psr4, string $directory, string $namespace): array
{
    $result = [];
    $mapped = false;

    foreach ($psr4 as $prefix => $target) {
        if ($target === $directory) {
            if (! $mapped) {
                $result[$namespace] = $directory;
                $mapped = true;
            }

            continue;
        }

        $result[(string) $prefix] = $target;
    }

    if (! $mapped) {
        $result[$namespace] = $directory;
    }

    return $result;
}

/** @param array<string, mixed> $json */
function write_json(string $path, array $json): void
{
    file_put_contents(
        $path,
        json_encode($json, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL,
    );
}

/**
 * Class and command names live in file names as well as in file contents, so
 * the textual pass alone leaves a package whose autoloader cannot find its own
 * classes. Use `git mv` inside a work tree to keep the rename in the index.
 *
 * @param array<string, string> $answers
 */
function rename_files(string $root, array $answers): int
{
    $renames = [
        'src/'.TEMPLATE['api_class'].'.php' => 'src/'.$answers['api_class'].'.php',
        'src/'.TEMPLATE['config_class'].'.php' => 'src/'.$answers['config_class'].'.php',
        'factories/'.TEMPLATE['config_class'].'Factory.php' => 'factories/'.$answers['config_class'].'Factory.php',
        'bin/'.TEMPLATE['bin'] => 'bin/'.$answers['slug'],
        'scripts/'.TEMPLATE['bin'] => 'scripts/'.$answers['slug'],
        'docs/skills/'.TEMPLATE['bin'].'.md' => 'docs/skills/'.$answers['slug'].'.md',
        'tests/Unit/'.TEMPLATE['api_class'].'Test.php' => 'tests/Unit/'.$answers['api_class'].'Test.php',
    ];

    $tracked = git('rev-parse --is-inside-work-tree') === 'true';
    $renamed = 0;

    foreach ($renames as $from => $to) {
        if ($from === $to || ! is_file($root.'/'.$from) || is_file($root.'/'.$to)) {
            continue;
        }

        if (move($root, $from, $to, $tracked)) {
            $renamed++;
        }
    }

    return $renamed;
}

function move(string $root, string $from, string $to, bool $tracked): bool
{
    if ($tracked) {
        exec('git mv '.escapeshellarg($from).' '.escapeshellarg($to).' 2>/dev/null', $output, $status);

        if ($status === 0) {
            return true;
        }
    }

    return rename($root.'/'.$from, $root.'/'.$to);
}

/**
 * Delete init, its `.gitattributes` line, and every test that only makes sense
 * in the template. Returns the paths removed, relative to the root.
 *
 * @return list<string>
 */
function remove_template_only(string $root): array
{
    $removed = [];

    unlink(__FILE__);
    $removed[] = 'init';

    $attributes = $root.'/.gitattributes';

    if (is_file($attributes)) {
        $contents = preg_replace('#^/init\s.*\R#m', '', (string) file_get_contents($attributes));
        file_put_contents($attributes, (string) $contents);
    }

    foreach (TEMPLATE_ONLY as $path) {
        if (is_file($root.'/'.$path) && unlink($root.'/'.$path)) {
            $removed[] = $path;
        }
    }

    return $removed;
}

/** @return list<string> */
function files(string $root): array
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveCallbackFilterIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
            static fn (SplFileInfo $file): bool => $file->isDir()
                ? ! in_array($file->getFilename(), SKIP_DIRECTORIES, true)
                : ! in_array($file->getFilename(), SKIP_FILES, true),
        ),
    );

    $files = [];

    /** @var SplFileInfo $file */
    foreach ($iterator as $file) {
        if ($file->isFile()) {
            $files[] = $file->getPathname();
        }
    }

    sort($files);

    return $files;
}

/*
|------------------------------------------------------------------------------
| Output
|------------------------------------------------------------------------------
*/

/** @param list<string> $removed */
function report_removed(array $removed): void
{
    if ($removed === []) {
        return;
    }

    writeln('');
    writeln('  Removed:');

    foreach ($removed as $path) {
        writeln('    '.$path);
    }
}

/** @param array<string, string> $answers */
function next_steps(array $answers): void
{
    $repository = repository($answers) !== '' ? repository($answers) : 'https://github.com/<org>/'.$answers['slug'];

    writeln('');
    writeln('Done. `composer test` runs the suite.');
    writeln('');
    writeln('    git add .');
    writeln('    git commit -m "Let\'s change the world\!"');
    writeln('    git remote add template https://github.com/zero-to-prod/sdk-generator.git');
    writeln('    git fetch template');
    writeln('    git config merge.keepours.driver true');
    writeln('    git log --oneline template/main');
    writeln('    git merge -s ours --allow-unrelated-histories sha -m "Graft template history"');
    writeln('    git config pull.rebase false');
    writeln('    git pull template main');
    writeln('See docs/template.md for more detail.');
    writeln('');
}

function writeln(string $line): void
{
    echo $line, PHP_EOL;
}

/*
|------------------------------------------------------------------------------
| Helpers
|------------------------------------------------------------------------------
*/

function ask(string $question, string $default): string
{
    echo sprintf('  %s [%s]: ', $question, $default !== '' ? $default : '-');

    $answer = trim(read());

    return $answer === '' ? $default : $answer;
}

/**
 * Prompt until the answer names a document the generator can read. An empty
 * answer would leave the package with the template's Widget models, which is
 * the one outcome nobody running this script wants.
 */
function ask_source(string $root, string $default): string
{
    while (true) {
        $source = ask('OpenAPI source (path or URL)', $default);

        if (str_starts_with($source, 'http://') || str_starts_with($source, 'https://')) {
            return $source;
        }

        if ($source !== '' && (is_file($source) || is_file($root.'/'.$source))) {
            return $source;
        }

        writeln('    Not a readable path or a URL. An OpenAPI document is required.');
    }
}

function confirm(string $question, bool $default = false): bool
{
    echo sprintf('  %s? [%s] ', $question, $default ? 'Y/n' : 'y/N');

    $answer = strtolower(trim(read()));

    return $answer === '' ? $default : in_array($answer, ['y', 'yes'], true);
}

/**
 * A closed stdin means no answer is ever coming, and every prompt here either
 * loops until it is answered or has a default that would be written silently.
 */
function read(): string
{
    $line = fgets(STDIN);

    if ($line === false) {
        fwrite(STDERR, "\ninit: stdin closed before every question was answered.\n");

        exit(1);
    }

    return $line;
}

function git(string $arguments): string
{
    return trim((string) shell_exec('git '.$arguments.' 2>/dev/null'));
}

function slugify(string $value): string
{
    return trim((string) preg_replace('/-+/', '-', (string) preg_replace('/[^a-z0-9]+/', '-', strtolower($value))), '-');
}

function titleise(string $value): string
{
    return ucwords((string) preg_replace('/[^a-zA-Z0-9]+/', ' ', $value));
}

/** `github-api` -> `GithubApi` */
function studly(string $value): string
{
    return str_replace(' ', '', titleise(strtolower($value)));
}

/**
 * A vendor becomes one namespace segment rather than one per word, which is
 * what makes `zero-to-prod` read as `Zerotoprod` and not `ZeroToProd`.
 */
function condense(string $value): string
{
    return ucfirst(strtolower((string) preg_replace('/[^a-zA-Z0-9]+/', '', $value)));
}

function namespace_for(string $vendor, string $slug): string
{
    $root = condense($vendor);
    $package = studly($slug) ?: studly(TEMPLATE['slug']);

    return $root === '' ? $package : $root.'\\'.$package;
}

/**
 * The package segment of the namespace, verbatim: `Zerotoprod\DatadogSdk` ->
 * `DatadogSdk`. No `Api` is appended -- the class is the package, and a slug
 * that already reads as one (`github-api` -> `GithubApi`) needs no help.
 */
function api_class_for(string $namespace, string $slug): string
{
    $segments = explode('\\', $namespace);
    $class = (string) end($segments);

    return $class !== '' ? $class : (studly($slug) ?: TEMPLATE['api_class']);
}

function config_class_for(string $api_class): string
{
    return str_ends_with($api_class, 'Api')
        ? substr($api_class, 0, -3).'Config'
        : $api_class.'Config';
}

/** @param array<string, string> $answers */
function composer_name(array $answers): string
{
    return ($answers['vendor'] !== '' ? $answers['vendor'] : 'app').'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function repository(array $answers): string
{
    return $answers['vendor'] === '' ? '' : 'https://github.com/'.$answers['vendor'].'/'.$answers['slug'];
}

/** @param array<string, string> $answers */
function author(array $answers): string
{
    return trim($answers['author'].($answers['author_email'] === '' ? '' : ' <'.$answers['author_email'].'>'));
}

/**
 * @param  array<string, string>  $answers
 * @return array{name: string, email?: string, role?: string}|null
 */
function author_record(array $answers): ?array
{
    if ($answers['author'] === '') {
        return null;
    }

    /** @var array{name: string, email?: string, role?: string} $record */
    $record = array_filter([
        'name' => $answers['author'],
        'email' => $answers['author_email'],
    ]);

    return $record;
}
